# Defaults only. Never put real secrets in this file: use real environment
# variables in production, or .env.local (git-ignored) for local development.
# For local development create .env.local containing: APP_ENV=dev

APP_ENV=prod
APP_SECRET=

# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgresql://mercurial:qwe@127.0.0.1:5432/symfony_api?charset=utf8"
# Abort any single SQL statement after this many ms (0 = no limit).
DB_STATEMENT_TIMEOUT_MS=5000

# JSON key casing of records: "lower" (id, title, ...) or "upper" (ID, TITLE, ...).
API_KEY_CASE=lower

# Secret for GET /api/logs (send as X-API-Key). Empty = endpoint disabled (404).
LOGS_API_KEY=

RATE_LIMIT_ENABLED=1
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_LOGGER_PER_MINUTE=20

# Comma-separated proxy IPs/CIDRs (or REMOTE_ADDR) whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=

# Regex of allowed browser origins for cross-origin requests.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
